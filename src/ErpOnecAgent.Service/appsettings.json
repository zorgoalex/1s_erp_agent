{
  "Agent": {
    "AgentId": "CHANGE-ME",
    "SiteId": "CHANGE-ME",
    "DataDirectory": "C:\\ProgramData\\ErpOnecAgent",
    "Environment": "Production",
    "GracefulShutdownSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "HealthCheckIntervalSeconds": 30
  },
  "Erp": {
    "BaseUrl": "https://erp.example.com",
    "ApiVersion": "v1",
    "LongPollSeconds": 25,
    "ClientCertificateThumbprint": "CHANGE-ME",
    "RequireClientCertificate": true,
    "AllowInsecureLoopbackForTesting": false,
    "RequestTimeoutSeconds": 60
  },
  "OneC": {
    "ODataBaseUrl": "http://1c-server/base/odata/standard.odata",
    "CommandApiBaseUrl": "http://1c-server/base/hs/erp-integration/v1",
    "CredentialSecretName": "onec-main",
    "HealthTimeoutSeconds": 5,
    "RequestTimeoutSeconds": 30
  },
  "Commands": {
    "MaxConcurrency": 1,
    "DefaultTimeoutSeconds": 30,
    "MaxPayloadBytes": 1048576,
    "MaxOperationalAttempts": 12,
    "MaxLookupAttempts": 24,
    "MaxPostAttempts": 12,
    "MaxResolutionAgeHours": 72,
    "RetryBaseDelaySeconds": 2,
    "RetryMaxDelaySeconds": 300,
    "SupportedTypes": [
      "create_customer_order",
      "update_customer_order",
      "post_customer_order",
      "cancel_customer_order",
      "create_material_movement",
      "create_material_receipt",
      "create_material_writeoff",
      "create_payment_document",
      "start_full_sync",
      "pause_etl",
      "resume_etl",
      "run_connectivity_test",
      "reload_entity",
      "reconcile_keys",
      "reconcile_totals",
      "collect_diagnostics",
      "rotate_certificate_hint"
    ]
  },
  "Etl": {
    "Enabled": true,
    "RunOnStartup": false,
    "IntervalMinutes": 60,
    "SafetyLagSeconds": 30,
    "DefaultPageSize": 500,
    "OverlapMinutes": 10,
    "MaxConcurrentRequests": 1,
    "MaxConcurrentBatchUploads": 2,
    "TargetBatchUncompressedBytes": 10485760,
    "Entities": []
  },
  "Storage": {
    "MaxSpoolBytes": 10737418240,
    "MaxSqliteBytes": 2147483648,
    "MaxBatchCompressedBytes": 104857600,
    "MinimumReservedBytesForCommands": 1073741824,
    "CompletedCommandRetentionDays": 30,
    "AcknowledgedBatchRetentionDays": 7,
    "BackupRetentionCount": 7,
    "MaintenanceIntervalHours": 6
  }
}
